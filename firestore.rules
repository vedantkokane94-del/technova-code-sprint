rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('.*@svit[.]ac[.]in') &&
        (request.auth.token.email in [
          'admin@svit.ac.in',
          'faculty@svit.ac.in',
          'technova.admin@svit.ac.in',
          'mentor@svit.ac.in'
        ] || request.auth.token.admin == true)
      );
    }

    // Users Collection: users can read and write only their own profile; admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Tasks Collection: read-only for students; writable only by admins
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Submissions Collection:
    // - Students can read only their own submissions
    // - Students can create or edit only their own submission before deadline
    // - Admins can read, score, and update all submissions
    match /submissions/{submissionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if (isOwner(resource.data.userId) && isOwner(request.resource.data.userId)) || isAdmin();
      allow delete: if isAdmin();
    }

    // Leaderboard Public Cache (sanitized scores)
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
