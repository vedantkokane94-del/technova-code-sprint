# -----------------------------------------------------------------------
# 1. ADMIN AUTHENTICATION
# -----------------------------------------------------------------------
# Plaintext password used exclusively in secure backend / migration scripts.
# Never expose ADMIN_PASSWORD to client-side bundles.
ADMIN_PASSWORD=technicalteam@282932

# Standard Bcrypt hash (Cost 10) for the admin password.
# Loaded by the client application for secure password comparison.
# Generate a new hash anytime using: npm run hash-password
VITE_ADMIN_PASSWORD_HASH=$2b$10$ZYadSLPwAhGbhqclMY/1E.c5ADCDg06GrCOV6Sl9EtE3JnzfSdiP6

# -----------------------------------------------------------------------
# 2. APPLICATION DOMAIN / URL
# -----------------------------------------------------------------------
# The public canonical URL where the app is deployed.
# Used for QR code generation on student certificates and verification URLs.
VITE_APP_URL=https://technova.svit.ac.in

# -----------------------------------------------------------------------
# 3. FIREBASE CONFIGURATION (OPTIONAL FOR CLOUD PERSISTENCE)
# -----------------------------------------------------------------------
# If provided, connects to live Firebase Firestore and Auth.
# If omitted or left as DEMO, operates in self-contained client storage mode.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=technova-svit-sprint.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=technova-svit-sprint
VITE_FIREBASE_STORAGE_BUCKET=technova-svit-sprint.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
