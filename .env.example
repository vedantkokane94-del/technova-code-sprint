# =======================================================================
# TECHNOVA CODE SPRINT (9 DAYS TO BUILD) - PRODUCTION CONFIGURATION
# Sir Visvesvaraya Institute of Technology (SVIT), Nashik
# Technical Skill Development Hub | Learn • Build • Grow
# =======================================================================

# -----------------------------------------------------------------------
# 1. ADMIN HARDWARE LOCK & AUTHENTICATION
# -----------------------------------------------------------------------
# Authorized administrator email address. Normalized and verified on server-side.
ADMIN_EMAIL=technicalteamsvit@gmail.com

# Bcrypt hash (Cost 12) of the master administrator password.
# Stored securely on the server only. Never exposed to client bundles or git.
# Generate a new hash anytime using: npm run admin:hash
ADMIN_PASSWORD_HASH=$2b$12$EXAMPLE_BCRYPT_COST_12_HASH_GENERATE_WITH_NPM_RUN_ADMIN_HASH

# Master One-Time Hardware Device Registration Key
# Required to bind the first trusted hardware device or execute CLI recovery.
# Must be a long, cryptographically random string.
ADMIN_SETUP_KEY=svit-technova-master-setup-key-2026-x9z

# Hidden, Non-Obvious Administrator Portal Route
# Obvious routes like /admin are permanently hidden and return 404 / redirect.
ADMIN_PATH=/svit-lead-command-2026
VITE_ADMIN_PATH=/svit-lead-command-2026

# Secret key used for cryptographic session signing and cookie HMACs
SESSION_SECRET=svit-technova-session-secret-2026-alpha

# Reverse Proxy Trust Configuration:
# Set to 'true' only if behind an institutional reverse proxy (Nginx / Cloudflare).
# If 'false', direct socket addresses are enforced to prevent IP spoofing via X-Forwarded-For.
TRUST_PROXY=false

# Optional: IP whitelist for administrator access (comma-separated or empty for no restriction)
# ADMIN_ALLOWED_IPS=127.0.0.1,::1

# Optional Backup Device: Set 'true' to allow up to 2 registered workstations (primary + backup)
ALLOW_BACKUP_DEVICE=false

# -----------------------------------------------------------------------
# 2. APPLICATION DOMAIN / PUBLIC VERIFICATION BASE URL
# -----------------------------------------------------------------------
# The public canonical URL where the app is deployed (e.g. https://technova.svit.ac.in).
# Used for QR code generation on student certificates and public verification links.
# NEVER set to localhost in production.
PUBLIC_BASE_URL=https://technova.svit.ac.in
VITE_PUBLIC_BASE_URL=https://technova.svit.ac.in
VITE_APP_URL=https://technova.svit.ac.in

# -----------------------------------------------------------------------
# 3. FIREBASE CONFIGURATION (OPTIONAL FOR CLOUD PERSISTENCE)
# -----------------------------------------------------------------------
# If provided, connects to live Firebase Firestore and Auth.
# If omitted or left as DEMO, operates in self-contained client storage mode.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=technova-svit-sprint.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=technova-svit-sprint
VITE_FIREBASE_STORAGE_BUCKET=technova-svit-sprint.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------------------------
# 4. BROWSER VERIFICATION & PROCTORING SESSION CONFIGURATION
# -----------------------------------------------------------------------
# Permitted desktop browsers for taking tests (comma-separated: chrome,edge,firefox)
ALLOWED_BROWSERS=chrome,edge,firefox
VITE_ALLOWED_BROWSERS=chrome,edge,firefox

# Minimum browser versions enforced before task can start
MIN_BROWSER_VERSIONS=chrome:110,edge:110,firefox:115
VITE_MIN_BROWSER_VERSIONS=chrome:110,edge:110,firefox:115

# Session heartbeat timeout threshold in seconds (default: 18)
# If no heartbeat is received within this time, test session expires and answers are auto-submitted
HEARTBEAT_TIMEOUT_SECONDS=18
